# ─────────────────────────────────────────────────────────────
# Vaquitapp — variables de entorno (ejemplo)
# Copiá este archivo a `.env` y completá los valores.
# `.env` está en .gitignore: NUNCA commitees secretos reales.
# ─────────────────────────────────────────────────────────────

# Servidor
NODE_ENV=development
PORT=3000
LOG_LEVEL=debug

# Base de datos local (docker-compose usa estas vars para crear el contenedor de Postgres).
# Completá POSTGRES_PASSWORD con una clave local cualquiera (no es un secreto de prod).
POSTGRES_USER=vaquitapp
POSTGRES_PASSWORD=
POSTGRES_DB=vaquitapp

# Connection string que usa el backend. Debe coincidir con las credenciales de arriba.
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/vaquitapp?schema=public"

# JWT — generá secretos únicos por entorno (mín. 32 chars).
# Podés generarlos con:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Se dejan vacíos a propósito: un placeholder largo se parece a un secreto real
# y lo levantan los escáneres. Vacío no puede ser un falso positivo, y config.ts
# corta el arranque con un error claro si no lo completás (mín. 32 chars).
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_TTL="15m"
JWT_REFRESH_TTL="30d"

# CORS — orígenes permitidos separados por coma (frontend web/mobile).
CORS_ORIGINS="http://localhost:5173"

# Job de gastos recurrentes — activar en UN solo servicio. Si se activa en
# más de una instancia, se materializan ocurrencias duplicadas.
ENABLE_SCHEDULER=false

# Almacenamiento de adjuntos (D7). STORAGE_PROVIDER=local guarda los archivos
# en disco y firma las URLs de descarga con LOCAL_STORAGE_SECRET; en
# producción usá STORAGE_PROVIDER=s3 y completá las variables S3_*.
STORAGE_PROVIDER=local
MAX_UPLOAD_BYTES=10485760
LOCAL_STORAGE_SECRET=
LOCAL_STORAGE_DIR="./uploads"
# S3_ENDPOINT=
# S3_REGION=
# S3_BUCKET=
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_FORCE_PATH_STYLE=true

# Rate limiting en /auth/register, /login, /refresh (protección contra
# fuerza bruta / credential stuffing). Ventana en ms.
AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_MAX=20

# ─────────────────────────────────────────────────────────────
# Variables que se irán incorporando en fases siguientes
# (todavía no las valida config/env.ts):
#
# Email (verificación / reset de password) — Fase 8
# SMTP_HOST=
# SMTP_PORT=
# SMTP_USER=
# SMTP_PASSWORD=
# MAIL_FROM="Vaquitapp <no-reply@vaquitapp.app>"
#
# Observabilidad — Fase 8
# SENTRY_DSN=
# ─────────────────────────────────────────────────────────────
