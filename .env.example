# ─────────────────────────────────────────────────────────────
# Vaquitapp — variables de entorno (ejemplo)
# Copiá este archivo a `.env` y completá los valores.
# `.env` está en .gitignore: NUNCA commitees secretos reales.
# ─────────────────────────────────────────────────────────────

# Servidor
NODE_ENV=development
PORT=3000
LOG_LEVEL=debug

# Base de datos local (docker-compose usa estas vars para crear el contenedor de Postgres).
# Completá POSTGRES_PASSWORD con una clave local cualquiera (no es un secreto de prod).
POSTGRES_USER=vaquitapp
POSTGRES_PASSWORD=
POSTGRES_DB=vaquitapp

# Connection string que usa el backend. Debe coincidir con las credenciales de arriba.
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/vaquitapp?schema=public"

# JWT — generá secretos únicos por entorno (mín. 32 chars).
# Podés generarlos con:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Se dejan vacíos a propósito: un placeholder largo se parece a un secreto real
# y lo levantan los escáneres. Vacío no puede ser un falso positivo, y config.ts
# corta el arranque con un error claro si no lo completás (mín. 32 chars).
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_TTL="15m"
JWT_REFRESH_TTL="30d"

# CORS — orígenes permitidos separados por coma (frontend web/mobile).
# En producción debe incluir al menos un origen que no sea localhost.
CORS_ORIGINS="http://localhost:5173"

# Jobs en segundo plano (gastos recurrentes + limpieza diaria de
# idempotency_keys y refresh tokens vencidos) — activar en UN solo servicio.
# Si se activa en más de una instancia, se materializan ocurrencias duplicadas.
ENABLE_SCHEDULER=false

# Almacenamiento de adjuntos (D7). STORAGE_PROVIDER=local guarda los archivos
# en disco y firma las URLs de descarga con LOCAL_STORAGE_SECRET; en
# producción usá STORAGE_PROVIDER=s3 (obligatorio con NODE_ENV=production) y
# completá las variables S3_*.
STORAGE_PROVIDER=local
MAX_UPLOAD_BYTES=10485760
LOCAL_STORAGE_SECRET=
LOCAL_STORAGE_DIR="./uploads"
#
# Con STORAGE_PROVIDER=s3 las cinco primeras son OBLIGATORIAS: si falta alguna,
# el proceso no arranca. Ojo con S3_ENDPOINT — sin ese valor el SDK asume AWS,
# y un proveedor S3-compatible fallaría recién en el primer upload.
#
# Valores para Cloudflare R2 (el free tier da 10 GB y no cobra egress):
#   S3_ENDPOINT=https://<ACCOUNT_ID>.r2.cloudflarestorage.com
#   S3_REGION=auto
# S3_ENDPOINT=
# S3_REGION=
# S3_BUCKET=
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_FORCE_PATH_STYLE=true

# Pool de conexiones a Postgres. Con Neon (URL *pooled*, pgbouncer) y una
# instancia chica alcanzan pocas conexiones.
DB_POOL_MAX=5
# OPCIONAL, apagado por defecto. Timeout de sentencia del lado del servidor.
# No lo actives con la URL pooled de Neon: pgbouncer rechaza parámetros de
# arranque que no conoce y ninguna conexión se establecería. Solo con URL directa.
# DB_STATEMENT_TIMEOUT_MS=15000

# Adjuntos: subidas simultáneas permitidas. Cada una se bufferea entera en
# memoria (hasta MAX_UPLOAD_BYTES); el exceso recibe 503 + Retry-After.
UPLOAD_CONCURRENCY=2

# Rate limiting (por IP). La ventana de /auth es compartida; cada endpoint
# tiene su propio presupuesto. Login cuenta solo los intentos fallidos.
AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_MAX=20
AUTH_REGISTER_RATE_LIMIT_MAX=20
# Más alto a propósito: cada cliente refresca cada ~15 minutos.
AUTH_REFRESH_RATE_LIMIT_MAX=120
# Límite global liviano sobre /api/v1.
API_RATE_LIMIT_WINDOW_MS=60000
API_RATE_LIMIT_MAX=300

# ─────────────────────────────────────────────────────────────
# Variables que se irán incorporando en fases siguientes
# (todavía no las valida config/env.ts):
#
# Email (verificación / reset de password) — Fase 8
# SMTP_HOST=
# SMTP_PORT=
# SMTP_USER=
# SMTP_PASSWORD=
# MAIL_FROM="Vaquitapp <no-reply@vaquitapp.app>"
#
# Observabilidad — Fase 8
# SENTRY_DSN=
# ─────────────────────────────────────────────────────────────
