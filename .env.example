# ─────────────────────────────────────────────────────────────
# Vaquitapp — variables de entorno (ejemplo)
# Copiá este archivo a `.env` y completá los valores.
# `.env` está en .gitignore: NUNCA commitees secretos reales.
# ─────────────────────────────────────────────────────────────

# Servidor
NODE_ENV=development
PORT=3000
LOG_LEVEL=debug

# Base de datos (PostgreSQL). En local apunta al contenedor de docker-compose.
DATABASE_URL="postgresql://vaquitapp:vaquitapp_dev@localhost:5432/vaquitapp?schema=public"

# JWT — generá secretos únicos por entorno (mín. 32 chars).
# Podés generarlos con:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_ACCESS_SECRET="cambiame-por-un-secreto-de-al-menos-32-caracteres"
JWT_REFRESH_SECRET="cambiame-por-otro-secreto-de-al-menos-32-caracteres"
JWT_ACCESS_TTL="15m"
JWT_REFRESH_TTL="30d"

# CORS — orígenes permitidos separados por coma (frontend web/mobile).
CORS_ORIGINS="http://localhost:5173"

# ─────────────────────────────────────────────────────────────
# Variables que se irán incorporando en fases siguientes
# (todavía no las valida config/env.ts):
#
# Scheduler de gastos recurrentes (activar en UN solo servicio)
# ENABLE_SCHEDULER=false
#
# Almacenamiento S3-compatible (adjuntos) — Fase 7
# S3_ENDPOINT=
# S3_REGION=
# S3_BUCKET=
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_FORCE_PATH_STYLE=true
#
# Email (verificación / reset de password) — Fase 8
# SMTP_HOST=
# SMTP_PORT=
# SMTP_USER=
# SMTP_PASSWORD=
# MAIL_FROM="Vaquitapp <no-reply@vaquitapp.app>"
#
# Observabilidad — Fase 8
# SENTRY_DSN=
# ─────────────────────────────────────────────────────────────
